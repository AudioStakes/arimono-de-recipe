{
  "name": "arimono-de-recipe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "biome check --write .",
    "format:unsafe": "biome check --write --unsafe .",
    "format:check": "biome ci .",
    "lint": "biome lint . && htmlhint index.html",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:structure && npm run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:structure": "vitest run tests/structure",
    "test:unit:watch": "vitest tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ui": "npm run test:e2e:ui",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test:unit && npm run test:structure && npm run test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@playwright/test": "latest",
    "@types/node": "^25.9.3",
    "htmlhint": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^4.1.7"
  }
}
