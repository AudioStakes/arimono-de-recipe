{
  "name": "arimono-de-recipe",
  "version": "0.1.0",
  "description": "家にある食材・材料から料理候補とAI向けレシピ依頼文を作るWebアプリ",
  "repository": {
    "type": "git",
    "url": "https://github.com/AudioStakes/arimono-de-recipe.git"
  },
  "bugs": {
    "url": "https://github.com/AudioStakes/arimono-de-recipe/issues"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:pages": "npm run build && wrangler pages dev dist --ai=AI",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "biome check --write --diagnostic-level=error --reporter=github --colors=off .",
    "format:unsafe": "biome check --write --unsafe --diagnostic-level=error --reporter=github --colors=off .",
    "format:check": "biome ci --diagnostic-level=error --reporter=github --colors=off .",
    "lint:design": "node scripts/lint-design-system.mjs",
    "lint": "npm run lint:design && biome lint --diagnostic-level=error --reporter=github --colors=off . && htmlhint --format unix --nocolor index.html",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:structure && npm run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:structure": "vitest run tests/structure",
    "test:unit:watch": "vitest tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ui": "npm run test:e2e:ui",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test:unit && npm run test:structure && npm run test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@playwright/test": "1.60.0",
    "@types/node": "22.20.4",
    "htmlhint": "1.9.2",
    "typescript": "7.0.2",
    "vite": "8.0.16",
    "vitest": "4.1.11",
    "wrangler": "4.144.0"
  }
}
