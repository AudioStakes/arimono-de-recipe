{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,css,html,json,jsonc}",
      "!!**/package-lock.json",
      "!!dist",
      "!!coverage",
      "!!playwright-report",
      "!!test-results"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useAwaitThenable": "error"
      },
      "correctness": {
        "noUnknownProperty": "error",
        "noUnknownFunction": "error",
        "noUnknownPseudoClass": "error",
        "noUnknownPseudoElement": "error",
        "noUnknownUnit": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "useConst": "error",
        "useImportType": "error",
        "useTemplate": "error",
        "useThrowOnlyError": "error"
      },
      "suspicious": {
        "noConsole": "error",
        "noDebugger": "error",
        "noDoubleEquals": "error",
        "noExplicitAny": "error",
        "noUnusedExpressions": "error",
        "noSkippedTests": "error",
        "noFocusedTests": "error",
        "noDuplicateProperties": "error",
        "noUnknownAtRules": "error",
        "noShorthandPropertyOverrides": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": ["src/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          },
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "process": "Browser code cannot use Node.js process.",
                  "Buffer": "Browser code cannot use Node.js Buffer.",
                  "require": "Browser code must use ESM imports.",
                  "__dirname": "Browser code cannot use Node.js __dirname.",
                  "__filename": "Browser code cannot use Node.js __filename.",
                  "global": "Browser code must use globalThis."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["scripts/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}", "tests/reporters/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
